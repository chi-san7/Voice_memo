<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_950"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_voice_memo"
        android:textColor="@color/sand_100"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/modeSelectionContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/modeSelectionTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_mode_selection"
            android:textColor="@color/sand_100"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modeSelectionDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hint_mode_selection"
            android:textColor="@color/slate_300"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@color/slate_800"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/onlineModeButton"
                    android:layout_width="match_parent"
                    android:layout_height="184dp"
                    android:backgroundTint="@color/signal_green"
                    android:contentDescription="@string/command_mode_online"
                    android:text="@string/button_mode_online"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/onlineModeHintTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/hint_mode_online"
                    android:textColor="@color/slate_300"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@color/slate_800"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/offlineModeButton"
                    android:layout_width="match_parent"
                    android:layout_height="184dp"
                    android:backgroundTint="@color/signal_red"
                    android:contentDescription="@string/command_mode_offline"
                    android:text="@string/button_mode_offline"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/offlineModeHintTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/hint_mode_offline"
                    android:textColor="@color/slate_300"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/operationContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/changeModeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/slate_800"
            android:contentDescription="@string/command_change_mode"
            android:text="@string/button_change_mode"
            android:textColor="@color/sand_100" />

        <TextView
            android:id="@+id/modeDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/slate_300"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/signal_green"
                android:contentDescription="@string/command_start"
                android:text="@string/button_start"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:backgroundTint="@color/signal_red"
                android:contentDescription="@string/command_stop"
                android:text="@string/button_stop"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/stateTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_state_title"
            android:textColor="@color/sand_100"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@color/slate_800"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <View
                android:id="@+id/statusIndicatorView"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/status_indicator_idle"
                android:contentDescription="@string/state_idle" />

            <TextView
                android:id="@+id/recordingTimeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/recording_time_initial"
                android:textColor="@color/sand_100"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/transcriptTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_transcript_title"
            android:textColor="@color/sand_100"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/textMemoEditText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@color/slate_800"
            android:ellipsize="end"
            android:gravity="top|start"
            android:hint="@string/hint_online"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="6"
            android:minHeight="132dp"
            android:padding="12dp"
            android:text="@string/hint_audio"
            android:textColor="@color/sand_100"
            android:textColorHint="@color/slate_300"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/savedPathTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_saved_path"
            android:textColor="@color/slate_300"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/latestSaveTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:text="@string/label_latest_save_empty"
            android:textColor="@color/sand_100"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
